[Unit]
Description=Interface app web adapter (loopback 127.0.0.1:9120, /app/ws)
After=network.target
Wants=network.target

[Service]
Type=simple
# Runs as root (same as hermes-gateway on this box): /root is mode 0700,
# so a dedicated service user cannot reach the proven P0 binding path
# (hermes binary via /root/.local/bin, MJ credentials in /root/.hermes).
# Loopback-only bind is enforced in code (adapter refuses non-127.0.0.1).
User=root
Group=root
# Secrets provisioned outside source control, service-user readable:
#   /etc/interface-app/mj-password.json (mode 0600)
#   /etc/interface-app/provider-secret (mode 0600)
#   /etc/interface-app/settings.json (this template filled in)
ExecStart=/usr/bin/python3 -m p5serve.serve /etc/interface-app/settings.json
WorkingDirectory=/opt/interface-app/releases/current
Environment=PYTHONPATH=/opt/interface-app/releases/current
# The in-process provider spawns the real Hermes CLI per agent turn. Mark
# those children supervised (as Hermes-managed processes are): the install
# carries a pending source-completion tail whose retry needs PyPI, which is
# unreachable from this box — without the marker every turn burns ~80s in
# uv retries and exits 1 with no terminal record. With it, the CLI runs on
# its committed dependencies, exactly like P0/P1 probe runs.
Environment=HERMES_SUPERVISED_CHILD=1
Restart=on-failure
RestartSec=5
# State lives outside release dirs; survives symlink swaps + reboot.
StateDirectory=interface-app
LogsDirectory=interface-app
# Minimal sandboxing: PrivateTmp + NoNewPrivileges only. Heavier
# lockdown (ProtectHome/ProtectSystem/IPAddressDeny) is deliberately NOT
# applied: the in-process provider spawns the real Hermes CLI, which needs
# read/write under /root/.hermes and real egress for model calls.
NoNewPrivileges=true
PrivateTmp=true
# Loopback only: no public bind. Caddy terminates TLS and routes only
# /app/ws on the chat.typeacid.ir block to 127.0.0.1:9120.

[Install]
WantedBy=multi-user.target
