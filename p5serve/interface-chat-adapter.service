[Unit]
Description=Interface app web adapter (loopback 127.0.0.1:9120, /app/ws)
After=network.target
Wants=network.target

[Service]
Type=simple
User=interface-app
Group=interface-app
# Secrets provisioned outside source control, service-user readable:
#   /etc/interface-app/mj-password.json (mode 0600)
#   /etc/interface-app/provider-secret (mode 0600)
#   /etc/interface-app/settings.json (this template filled in)
ExecStart=/usr/bin/python3 -m p5serve.serve /etc/interface-app/settings.json
WorkingDirectory=/opt/interface-app/releases/current
Restart=on-failure
RestartSec=5
# State lives outside release dirs; survives symlink swaps + reboot.
StateDirectory=interface-app
LogsDirectory=interface-app
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/interface-app
# Loopback only: no public bind. Caddy terminates TLS and routes only
# /app/ws on the chat.typeacid.ir block to 127.0.0.1:9120.
IPAddressAllow=127.0.0.1
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
