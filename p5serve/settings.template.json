{
  "adapter": {
    "bind_host": "127.0.0.1",
    "bind_port": 9120,
    "path": "/app/ws",
    "origin": "https://chat.typeacid.ir",
    "host": "chat.typeacid.ir",
    "subprotocol": "hermes.web.v1",
    "state_db": "/var/lib/interface-app/serving.sqlite3",
    "release_id": "REQUIRED_RELEASE_ID",
    "max_connections": 8,
    "http_header_bytes": 16384,
    "http_body_bytes": 16384,
    "http_timeout_seconds": 10,
    "frame_bytes": 1048576,
    "json_depth": 64,
    "write_timeout_seconds": 10,
    "sqlite_busy_seconds": 2,
    "outbound_messages": 64,
    "outbound_bytes": 2097152,
    "queue_safety_messages": 64,
    "queue_safety_bytes": 2097152,
    "retry_after_seconds": 60,
    "ws_ping_seconds": 20,
    "ws_pong_timeout_seconds": 10,
    "session_check_seconds": 1,
    "credential_check_seconds": 1,
    "reconnect_base_seconds": 1,
    "reconnect_factor": 2,
    "reconnect_cap_seconds": 30,
    "reconnect_stable_seconds": 60,
    "draft_bytes": 65536,
    "frame_min_height": 80,
    "frame_max_height": 800,
    "frame_ready_timeout_seconds": 10
  },
  "auth": {
    "account_id": "mj",
    "password_file": "/etc/interface-app/mj-password.json",
    "cookie_name": "__Host-chat",
    "preauth_cookie_name": "__Host-chat-pre",
    "token_bytes": 32,
    "csrf_bytes": 32,
    "salt_bytes": 16,
    "scrypt_n": 16384,
    "scrypt_r": 8,
    "scrypt_p": 1,
    "scrypt_dklen": 32,
    "absolute_seconds": 86400,
    "idle_seconds": 3600,
    "preauth_seconds": 300,
    "login_window_seconds": 300,
    "login_attempts_per_account": 5,
    "login_attempts_per_peer": 10,
    "command_window_seconds": 60,
    "commands_per_session": 60
  },
  "upstream": {
    "host": "127.0.0.1",
    "port": 9121,
    "service_secret_file": "/etc/interface-app/provider-secret",
    "connect_timeout_seconds": 5,
    "write_timeout_seconds": 10,
    "read_timeout_seconds": 330,
    "tcp_keepalive": true,
    "tcp_idle_seconds": 30,
    "tcp_interval_seconds": 10,
    "tcp_probes": 3
  },
  "provider": {
    "enabled": true,
    "bind_host": "127.0.0.1",
    "bind_port": 9121,
    "hermes_executable": "/root/.local/bin/hermes",
    "hermes_home": "/root/.hermes",
    "workspace": "/var/lib/interface-app/work",
    "agent_timeout_seconds": 300,
    "termination_grace_seconds": 10,
    "output_bytes": 4194304,
    "stdout_line_bytes": 1048576,
    "actions_enabled": false,
    "drawer_writes_enabled": false
  },
  "policy": {
    "file": "/var/lib/interface-app/admission-policy.json"
  }
}
